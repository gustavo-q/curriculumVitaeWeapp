{
  "description": "简历制作小程序 · 参考 curriculumVitae 网站功能实现",
  "miniprogramRoot": "./",
  "compileType": "miniprogram",
  "libVersion": "3.5.0",
  "appid": "wx45e193b0f51dbcaa",
  "projectname": "curriculumVitaeWeapp",
  "simulatorType": "wechat",
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  },
  "packOptions": {
    "comment": "只有下列文件会进入代码包：小程序源码与内置头像资源。开发期产物（.work 的仿真页与无头 Chrome profile、.npm-cache、.npm-logs、node_modules、tools 回归脚本）一律排除——它们合计 250MB 以上，而主包上限只有 1.5MB。",
    "ignore": [
      { "type": "folder", "value": "node_modules" },
      { "type": "folder", "value": ".work" },
      { "type": "folder", "value": ".port" },
      { "type": "folder", "value": ".npm-cache" },
      { "type": "folder", "value": ".npm-logs" },
      { "type": "folder", "value": ".git" },
      { "type": "folder", "value": "tools" },
      { "type": "file", "value": "package.json" },
      { "type": "file", "value": "package-lock.json" },
      { "type": "file", "value": "pnpm-lock.yaml" },
      { "type": "file", "value": "README.md" },
      { "type": "file", "value": ".gitignore" },
      { "type": "file", "value": ".DS_Store" },
      { "type": "suffix", "value": ".md" },
      { "type": "suffix", "value": ".cjs" },
      { "type": "suffix", "value": ".mjs" },
      { "type": "suffix", "value": ".log" },
      { "type": "suffix", "value": ".DS_Store" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "coverView": true,
    "nodeModules": false,
    "autoAudits": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "compileHotReLoad": true,
    "useMultiFrameRuntime": true,
    "useApiHook": true,
    "useApiHostProcess": true,
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    },
    "useIsolateContext": true,
    "userConfirmedBundleSwitch": false,
    "packNpmManually": false,
    "packNpmRelationList": [],
    "minifyWXSS": true,
    "disableUseStrict": false,
    "minifyWXML": true,
    "showES6CompileOption": false,
    "useCompilerPlugins": false,
    "ignoreUploadUnusedFiles": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "newFeature": false,
    "scopeDataCheck": false,
    "uglifyFileName": false,
    "showShadowRootInWxmlPanel": true
  }
}
