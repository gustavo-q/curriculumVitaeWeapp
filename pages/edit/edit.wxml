<view class="nav-wrap">
  <nav-bar
    title="{{title}}{{dirty ? ' ·' : ''}}"
    action="更多"
    status-bar-height="{{statusBarHeight}}"
    bar-height="{{navBarHeight}}"
    bind:action="onMore" />
  <!-- 导航栏标题本身不可点（pointer-events:none），这里叠一层透明热区：点标题改名 -->
  <view class="title-hit" style="top:{{statusBarHeight}}px;height:{{navBarHeight}}px;{{titleHitStyle}}" bindtap="onRename"></view>
</view>

<scroll-view
  class="body"
  scroll-y="{{scrollEnabled}}"
  scroll-into-view="{{scrollInto}}"
  scroll-with-animation>

  <!-- ================= 调整顺序模式 ================= -->
  <block wx:if="{{sortMode}}">
    <view id="sort-top" class="sort-head">
      <view class="grow">
        <view class="sort-title">调整区块顺序</view>
        <view class="sort-tip">按住右侧 ⠿ 上下拖动</view>
      </view>
      <view class="btn btn-sm btn-primary sort-done" bindtap="exitSortMode" hover-class="tap-hover">完成</view>
    </view>
    <view
      wx:for="{{sortRows}}"
      wx:key="id"
      class="sort-row {{drag.id === item.id ? 'dragging' : ''}} {{drag.list === 'sort' && dropIndex === index && drag.id !== item.id ? 'drop-target' : ''}} {{item.visible ? '' : 'off'}}"
      style="transform:translateY({{item.offsetY}}rpx);z-index:{{drag.id === item.id ? 5 : 1}}">
      <text class="sort-idx">{{index + 1}}</text>
      <view class="grow">
        <view class="sort-name ellipsis">{{item.title}}</view>
        <view class="sort-sub">{{item.count}} 条{{item.visible ? '' : ' · 已隐藏'}}</view>
      </view>
      <view
        class="grip"
        data-list="sort"
        data-id="{{item.id}}"
        data-index="{{index}}"
        catchtouchstart="onRowStart"
        catchtouchmove="onRowMove"
        catchtouchend="onRowEnd"
        catchtouchcancel="onRowCancel">⠿</view>
    </view>
  </block>

  <block wx:else>
    <!-- ================= 基本信息 ================= -->
    <view id="card-base" class="card sec-card {{flashId === 'card-base' ? 'flash' : ''}}">
      <view class="card-head">
        <text class="card-title">基本信息</text>
        <text class="guide-link" data-title="基本信息" bindtap="onGuide">这一栏怎么写 ›</text>
      </view>
      <view class="base-tip">右侧开关决定该项是否出现在简历上</view>
      <view wx:for="{{baseRows}}" wx:key="key" class="base-row {{item.on ? '' : 'off'}}">
        <text class="base-label">{{item.label}}</text>
        <view class="base-ctl">
          <picker wx:if="{{item.kind === 'month'}}" mode="date" fields="month" value="{{item.pickerValue}}" start="1950-01" end="2015-12" data-key="{{item.key}}" bindchange="onBirthday">
            <view class="base-picker {{item.value ? '' : 'ph'}}">{{item.value || '选择年月'}}</view>
          </picker>
          <picker wx:elif="{{item.kind === 'gender'}}" range="{{genders}}" value="{{item.genderIndex}}" bindchange="onGender">
            <view class="base-picker {{item.value ? '' : 'ph'}}">{{item.value || '选择'}}</view>
          </picker>
          <input
            wx:elif="{{item.kind === 'number'}}"
            class="base-input"
            type="number"
            value="{{item.value}}"
            placeholder="{{item.ph}}"
            placeholder-class="ph"
            focus="{{focusKey === item.key}}"
            confirm-type="next"
            data-scope="base"
            data-key="{{item.key}}"
            bindinput="onInput"
            bindblur="onBlur"
            bindconfirm="onConfirmNext" />
          <input
            wx:else
            class="base-input"
            type="text"
            inputmode="{{item.kind === 'email' ? 'email' : 'text'}}"
            value="{{item.value}}"
            placeholder="{{item.ph}}"
            placeholder-class="ph"
            focus="{{focusKey === item.key}}"
            confirm-type="next"
            data-scope="base"
            data-key="{{item.key}}"
            bindinput="onInput"
            bindblur="onBlur"
            bindconfirm="onConfirmNext" />
        </view>
        <view class="switch-hit" data-key="{{item.key}}" bindtap="onToggleField">
          <view class="switch {{item.on ? 'on' : ''}}"><view class="knob"></view></view>
        </view>
      </view>
    </view>

    <!-- ================= 照片 ================= -->
    <view id="card-photo" class="card sec-card {{flashId === 'card-photo' ? 'flash' : ''}}">
      <view class="card-head">
        <text class="card-title">照片</text>
      </view>
      <view class="photo-main">
        <view class="photo-box" style="height:{{photo.boxH}}rpx">
          <image wx:if="{{photo.src}}" class="photo-img photo-{{photo.shape}} photo-b-{{photo.border}}" src="{{photo.src}}" mode="aspectFill" />
          <view wx:else class="photo-empty">无照片</view>
        </view>
        <view class="photo-acts">
          <view class="btn btn-sm btn-primary" bindtap="onChoosePhoto" hover-class="tap-hover">相册或拍照</view>
          <view class="chip-row">
            <view wx:for="{{photoPresets}}" wx:key="id" class="chip {{photo.raw === item.url ? 'on' : ''}}" data-url="{{item.url}}" bindtap="onPreset" hover-class="tap-hover">内置{{item.label}}</view>
          </view>
          <view wx:if="{{photo.src}}" class="link-danger" bindtap="onRemovePhoto">移除照片</view>
        </view>
      </view>
      <view class="opt-label">裁剪比例</view>
      <view class="chip-row">
        <view wx:for="{{cropRatios}}" wx:key="id" class="chip {{cropRatio === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onCropRatio" hover-class="tap-hover">{{item.label}}</view>
      </view>
      <view class="opt-label">外形</view>
      <view class="chip-row">
        <view wx:for="{{photoShapes}}" wx:key="id" class="chip {{photo.shape === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPhotoShape" hover-class="tap-hover">{{item.label}}</view>
      </view>
      <view class="opt-label">边框</view>
      <view class="chip-row">
        <view wx:for="{{photoBorders}}" wx:key="id" class="chip {{photo.border === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPhotoBorder" hover-class="tap-hover">{{item.label}}</view>
      </view>
    </view>

    <!-- ================= 区块 ================= -->
    <view
      wx:for="{{sections}}"
      wx:for-item="sec"
      wx:for-index="si"
      wx:key="id"
      id="sec-{{sec.id}}"
      class="card sec-card {{sec.visible ? '' : 'hidden'}} {{flashId === 'sec-' + sec.id ? 'flash' : ''}}">
      <!-- 标题栏：左滑露出 显示/隐藏 · 删除；长按进入调整顺序 -->
      <view class="head-wrap">
        <view class="head-acts">
          <view class="act act-toggle" data-sec="{{sec.id}}" catchtap="onHeadToggle">{{sec.visible ? '隐藏' : '显示'}}</view>
          <view class="act act-del" data-sec="{{sec.id}}" catchtap="onHeadDelete">删除</view>
        </view>
        <view
          class="head-face {{movingId === sec.id ? 'moving' : ''}}"
          style="transform:translateX({{sec.offsetX}}rpx)"
          data-list="head"
          data-id="{{sec.id}}"
          data-index="{{si}}"
          bindtouchstart="onRowStart"
          bindtouchmove="onRowMove"
          bindtouchend="onRowEnd"
          bindtouchcancel="onRowCancel">
          <view class="head-bar"></view>
          <input
            class="head-title"
            value="{{sec.title}}"
            confirm-type="done"
            maxlength="20"
            data-role="input"
            data-scope="section"
            data-sec="{{sec.id}}"
            bindinput="onInput"
            bindblur="onBlur" />
          <text wx:if="{{!sec.visible}}" class="tag">已隐藏</text>
          <view class="head-more" data-role="more" data-sec="{{sec.id}}" catchtap="onSectionMore" hover-class="tap-hover">⋯</view>
        </view>
      </view>

      <view class="sec-links">
        <text class="guide-link" data-title="{{sec.title}}" bindtap="onGuide">这一栏怎么写 ›</text>
        <text class="guide-link" data-sec="{{sec.id}}" bindtap="onSectionMoreCopy">从其他简历复制</text>
      </view>

      <view
        wx:for="{{sec.items}}"
        wx:key="id"
        class="item-row irow-{{sec.id}} {{drag.id === item.id ? 'dragging' : ''}} {{drag.list === 'item' && drag.secId === sec.id && dropIndex === index && drag.id !== item.id ? 'drop-target' : ''}}"
        style="transform:translateY({{item.offsetY}}rpx);z-index:{{drag.id === item.id ? 5 : 1}}"
        data-list="item"
        data-id="{{item.id}}"
        data-sec="{{sec.id}}"
        data-index="{{index}}"
        bindtouchstart="onRowStart"
        bindtouchmove="onRowMove"
        bindtouchend="onRowEnd"
        bindtouchcancel="onRowCancel"
        hover-class="tap-hover-bg"
        hover-stay-time="60">
        <view class="item-body">
          <view class="item-main {{item.empty ? 'ph' : ''}}">{{item.empty ? '空条目，点击填写' : item.main}}</view>
          <view wx:if="{{item.sub}}" class="item-sub">{{item.sub}}</view>
        </view>
        <text class="item-type">{{item.typeLabel}}</text>
        <text class="item-arrow">›</text>
      </view>
      <view wx:if="{{!sec.items.length}}" class="sec-empty">还没有条目</view>

      <view class="add-item" data-sec="{{sec.id}}" bindtap="onAddItem" hover-class="tap-hover-bg">＋ 添加条目</view>
      <view wx:if="{{sec.items.length > 1}}" class="drag-tip">长按条目可拖动排序</view>
    </view>

    <view class="bottom-acts">
      <view class="btn btn-add" bindtap="onAddSection" hover-class="tap-hover">＋ 添加区块</view>
      <view wx:if="{{sections.length > 1}}" class="btn btn-ghost" bindtap="enterSortMode" hover-class="tap-hover">调整区块顺序</view>
    </view>
  </block>

  <view class="body-end"></view>
</scroll-view>

<!-- ================= 撤销条 ================= -->
<view wx:if="{{undoBar.show}}" class="undo-bar">
  <text class="undo-label ellipsis">{{undoBar.label}}</text>
  <view class="undo-btn" bindtap="onUndoBar" hover-class="tap-hover">撤销</view>
</view>

<!-- ================= 底部固定栏 ================= -->
<view class="tabbar">
  <view class="tab on" data-tab="form" bindtap="onTab">
    <text class="tab-icon">✎</text><text class="tab-label">填写</text>
  </view>
  <view class="tab" data-tab="style" bindtap="onTab" hover-class="tap-hover-bg">
    <text class="tab-icon">◐</text><text class="tab-label">样式</text>
  </view>
  <view class="tab" data-tab="preview" bindtap="onTab" hover-class="tap-hover-bg">
    <text class="tab-icon">▤</text><text class="tab-label">预览</text>
  </view>
  <view class="tab" data-tab="export" bindtap="onTab" hover-class="tap-hover-bg">
    <text class="tab-icon">⇪</text><text class="tab-label">导出</text>
  </view>
</view>

<!-- ================= 从其他简历复制（底部弹层） ================= -->
<view wx:if="{{copySheet.show}}" class="sheet-mask" bindtap="closeCopySheet" catchtouchmove="noop"></view>
<view wx:if="{{copySheet.show}}" class="sheet">
  <view class="sheet-head">
    <view class="grow">
      <view class="sheet-title">从其他简历复制</view>
      <view class="sheet-sub ellipsis">勾选条目加入「{{copySheet.targetTitle}}」，或整块复制为新区块</view>
    </view>
    <text class="sheet-close" bindtap="closeCopySheet">关闭</text>
  </view>
  <scroll-view class="sheet-body" scroll-y>
    <view wx:if="{{!copySheet.drafts.length}}" class="sheet-empty">没有其他简历可以复制。可在「简历」页新建或导入。</view>
    <view wx:for="{{copySheet.drafts}}" wx:for-item="d" wx:for-index="di" wx:key="id" class="cp-draft">
      <view class="cp-draft-head" data-di="{{di}}" bindtap="onCopyDraftToggle" hover-class="tap-hover-bg">
        <text class="cp-caret {{d.open ? 'open' : ''}}">›</text>
        <text class="grow ellipsis cp-draft-name">{{d.name}}</text>
        <text wx:if="{{d.archived}}" class="tag">已归档</text>
      </view>
      <block wx:if="{{d.open}}">
        <view wx:for="{{d.sections}}" wx:for-item="s" wx:for-index="si" wx:key="id" class="cp-sec">
          <view class="cp-sec-head">
            <text class="grow ellipsis cp-sec-title">{{s.title}}<text wx:if="{{s.same}}" class="cp-same"> 同名</text></text>
            <view class="cp-whole" data-di="{{di}}" data-si="{{si}}" bindtap="onCopyWholeSection" hover-class="tap-hover">整块复制</view>
          </view>
          <view
            wx:for="{{s.items}}"
            wx:for-item="it"
            wx:for-index="ii"
            wx:key="id"
            class="cp-item"
            data-di="{{di}}"
            data-si="{{si}}"
            data-ii="{{ii}}"
            bindtap="onCopyItemToggle"
            hover-class="tap-hover-bg">
            <view class="check {{it.checked ? 'on' : ''}}">{{it.checked ? '✓' : ''}}</view>
            <view class="grow">
              <view class="cp-item-main">{{it.main}}</view>
              <view wx:if="{{it.sub}}" class="cp-item-sub">{{it.sub}}</view>
            </view>
          </view>
        </view>
      </block>
    </view>
  </scroll-view>
  <view class="sheet-foot">
    <view class="btn btn-primary {{copySheet.count ? '' : 'btn-disabled'}}" bindtap="onCopySelected" hover-class="tap-hover">加入「{{copySheet.targetTitle}}」{{copySheet.count ? '（' + copySheet.count + ' 条）' : ''}}</view>
  </view>
</view>
