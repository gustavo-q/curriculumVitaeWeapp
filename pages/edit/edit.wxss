page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg);
}

.nav-wrap { position: relative; flex: none; }
.title-hit {
  position: absolute;
  z-index: 3;
}

.body {
  flex: 1;
  height: 0;
  padding: 20rpx 24rpx 0;
  box-sizing: border-box;
}
.body-end { height: 200rpx; }

/* ---------- 卡片 ---------- */
.sec-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 8rpx 28rpx 20rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 2rpx 10rpx rgba(20, 40, 70, 0.05);
  overflow: hidden;
  transition: box-shadow 0.3s ease;
}
.sec-card.flash { box-shadow: 0 0 0 4rpx var(--brand-ring), 0 2rpx 10rpx rgba(20, 40, 70, 0.05); }
.sec-card.hidden .item-row,
.sec-card.hidden .head-title { opacity: 0.55; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}
.card-title { font-size: 32rpx; font-weight: 700; color: var(--ink); }
.guide-link {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 4rpx;
  font-size: 24rpx;
  color: var(--brand-2);
}

/* ---------- 基本信息 ---------- */
.base-tip { font-size: 23rpx; color: var(--ink-3); margin-bottom: 8rpx; }
.base-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1px solid var(--line);
}
.base-row:last-child { border-bottom: none; }
.base-label { flex: none; width: 150rpx; font-size: 27rpx; color: var(--ink-2); }
.base-ctl { flex: 1; min-width: 0; }
.base-input,
.base-picker {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 29rpx;
  color: var(--ink);
}
.base-row.off .base-label,
.base-row.off .base-input,
.base-row.off .base-picker { color: var(--ink-4); }
.ph { color: var(--ink-4); }
.switch-hit {
  flex: none;
  height: 88rpx;
  padding-left: 16rpx;
  display: flex;
  align-items: center;
}
.switch {
  position: relative;
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--line-2);
  transition: background 0.2s;
}
.switch.on { background: var(--brand); }
.knob {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.2s;
}
.switch.on .knob { transform: translateX(36rpx); }

/* ---------- 照片 ---------- */
.photo-main { display: flex; gap: 28rpx; align-items: flex-start; }
.photo-box {
  flex: none;
  width: 150rpx;
  min-height: 150rpx;
  max-height: 260rpx;
  border-radius: 10rpx;
  background: var(--surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
}
.photo-img { width: 100%; height: 100%; border-radius: 4rpx; }
.photo-rounded { border-radius: 16rpx; }
.photo-circle { border-radius: 50%; }
.photo-b-thin { border: 1px solid var(--line-2); }
.photo-b-theme { border: 3rpx solid var(--brand); }
.photo-b-shadow { box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.18); }
.photo-empty { font-size: 23rpx; color: var(--ink-4); }
.photo-acts { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16rpx; }
.link-danger { font-size: 25rpx; color: var(--danger); min-height: 56rpx; display: flex; align-items: center; }
.opt-label { margin: 22rpx 0 10rpx; font-size: 24rpx; color: var(--ink-3); }
.chip-row { display: flex; flex-wrap: wrap; gap: 14rpx; }
.chip {
  min-height: 68rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  border-radius: 34rpx;
  font-size: 25rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.chip.on { color: var(--brand); background: var(--brand-soft); border-color: var(--brand-ring); font-weight: 600; }

/* ---------- 区块标题栏（左滑） ---------- */
.head-wrap {
  position: relative;
  margin: 0 -28rpx;
  overflow: hidden;
}
.head-acts {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 300rpx;
  display: flex;
}
.act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 27rpx;
  font-weight: 600;
}
.act-toggle { background: #5b6570; }
.act-del { background: var(--danger); }
.head-face {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 100rpx;
  padding: 0 12rpx 0 28rpx;
  background: var(--surface);
  transition: transform 0.2s ease;
}
.head-face.moving { transition: none; }
.head-bar { flex: none; width: 8rpx; height: 32rpx; border-radius: 4rpx; background: var(--brand); }
.head-title {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}
.head-more {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--ink-3);
}
.sec-links { display: flex; justify-content: space-between; margin: -8rpx 0 6rpx; }

/* ---------- 条目行 ---------- */
.item-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 104rpx;
  padding: 14rpx 6rpx 14rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  transition: transform 0.18s ease, box-shadow 0.18s ease;
}
.item-row.dragging {
  transition: none;
  background: #fff;
  box-shadow: 0 14rpx 32rpx rgba(20, 40, 70, 0.2);
}
.item-row.drop-target { box-shadow: 0 0 0 3rpx var(--brand-ring); }
.item-body { flex: 1; min-width: 0; }
.item-main {
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.item-sub { margin-top: 4rpx; font-size: 23rpx; color: var(--ink-3); }
.item-type {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: var(--ink-3);
  border: 1px solid var(--line-2);
}
.item-arrow { flex: none; width: 36rpx; text-align: center; font-size: 34rpx; color: var(--ink-4); }
.sec-empty { padding: 24rpx 0; font-size: 25rpx; color: var(--ink-4); text-align: center; }
.add-item {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed var(--line-2);
  border-radius: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  color: var(--brand);
}
.drag-tip { margin-top: 10rpx; font-size: 21rpx; color: var(--ink-4); text-align: center; }

.bottom-acts { display: flex; flex-direction: column; gap: 12rpx; margin: 8rpx 0 20rpx; }
.btn-add { border-style: dashed; color: var(--brand); background: transparent; }

/* ---------- 调整顺序模式 ---------- */
.sort-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 4rpx 24rpx;
}
.sort-title { font-size: 32rpx; font-weight: 700; }
.sort-tip { font-size: 23rpx; color: var(--ink-3); }
.sort-done { flex: none; width: 160rpx; }
.sort-row {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  margin-bottom: 14rpx;
  padding-left: 24rpx;
  border-radius: 16rpx;
  background: var(--surface);
  box-shadow: 0 2rpx 8rpx rgba(20, 40, 70, 0.05);
  transition: transform 0.18s ease;
}
.sort-row.off { opacity: 0.6; }
.sort-row.dragging { transition: none; box-shadow: 0 16rpx 36rpx rgba(20, 40, 70, 0.22); }
.sort-row.drop-target { box-shadow: 0 0 0 4rpx var(--brand-ring); }
.sort-idx {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
.sort-name { font-size: 29rpx; font-weight: 600; }
.sort-sub { font-size: 22rpx; color: var(--ink-3); }
.grip {
  flex: none;
  width: 112rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--ink-3);
}

/* ---------- 撤销条 ---------- */
.undo-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  z-index: 30;
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
  padding: 0 12rpx 0 32rpx;
  border-radius: 16rpx;
  background: #23282f;
  color: #fff;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
}
.undo-label { flex: 1; min-width: 0; font-size: 27rpx; }
.undo-btn {
  flex: none;
  min-height: 80rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8cc4ff;
}

/* ---------- 底部固定栏 ---------- */
.tabbar {
  flex: none;
  display: flex;
  background: var(--surface);
  border-top: 1px solid var(--line);
  padding-bottom: env(safe-area-inset-bottom);
}
.tab {
  flex: 1;
  height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  color: var(--ink-3);
}
.tab.on { color: var(--brand); }
.tab-icon { font-size: 34rpx; line-height: 1.1; }
.tab-label { font-size: 22rpx; font-weight: 600; }

/* ---------- 复制弹层 ---------- */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  background: rgba(0, 0, 0, 0.4);
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 41;
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  border-radius: 28rpx 28rpx 0 0;
  background: var(--surface);
  padding-bottom: env(safe-area-inset-bottom);
}
.sheet-head { display: flex; align-items: center; gap: 16rpx; padding: 28rpx 28rpx 16rpx; }
.sheet-title { font-size: 32rpx; font-weight: 700; }
.sheet-sub { font-size: 23rpx; color: var(--ink-3); }
.sheet-close { flex: none; min-height: 72rpx; padding: 0 12rpx; display: flex; align-items: center; color: var(--ink-3); font-size: 27rpx; }
.sheet-body { flex: 1; height: 0; min-height: 300rpx; max-height: 60vh; padding: 0 24rpx; box-sizing: border-box; }
.sheet-empty { padding: 60rpx 20rpx; text-align: center; font-size: 26rpx; color: var(--ink-3); }
.sheet-foot { padding: 16rpx 24rpx; border-top: 1px solid var(--line); }
.cp-draft { border-bottom: 1px solid var(--line); }
.cp-draft-head { display: flex; align-items: center; gap: 12rpx; min-height: 96rpx; }
.cp-caret { font-size: 32rpx; color: var(--ink-3); transition: transform 0.2s; }
.cp-caret.open { transform: rotate(90deg); }
.cp-draft-name { font-size: 28rpx; font-weight: 600; }
.cp-sec { margin: 0 0 16rpx 30rpx; }
.cp-sec-head { display: flex; align-items: center; gap: 12rpx; min-height: 72rpx; }
.cp-sec-title { font-size: 26rpx; font-weight: 600; color: var(--ink-2); }
.cp-same { font-size: 20rpx; color: var(--brand); font-weight: 400; }
.cp-whole {
  flex: none;
  min-height: 60rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  border-radius: 30rpx;
  font-size: 23rpx;
  color: var(--brand);
  border: 1px solid var(--brand-ring);
}
.cp-item { display: flex; align-items: center; gap: 18rpx; min-height: 88rpx; padding: 8rpx 4rpx; border-radius: 10rpx; }
.cp-item-main { font-size: 26rpx; color: var(--ink); }
.cp-item-sub { font-size: 22rpx; color: var(--ink-3); }
.check {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--line-2);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.check.on { background: var(--brand); border-color: var(--brand); }
