.page-head { padding: 30rpx 28rpx 8rpx; }
.head-title { font-size: 40rpx; font-weight: 700; letter-spacing: 2rpx; }
.head-desc { margin-top: 6rpx; font-size: 24rpx; color: var(--ink-3); }

.cats { white-space: nowrap; padding: 16rpx 28rpx 6rpx; }
.cat {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  /* 96rpx ≈ 41px @320px：分类 chip 是主筛选入口，太矮会点不中（原 8rpx 内边距仅 23.9px） */
  min-height: 96rpx;
  padding: 8rpx 28rpx;
  margin-right: 12rpx;
  border: 1px solid #d7dde5;
  border-radius: 30rpx;
  background: #fff;
  font-size: 26rpx;
  color: #5b6570;
}
.cat.on { background: #1f4e79; border-color: #1f4e79; color: #fff; }

.grid { padding: 12rpx 28rpx 40rpx; }

/* 分类下没有模板时的空状态（分类由模板 tags 派生，正常不会触发） */
.cat-empty {
  padding: 80rpx 40rpx;
  text-align: center;
  background: #fff;
  border: 1px solid #e4e8ee;
  border-radius: 18rpx;
}
.cat-empty-title { font-size: 30rpx; font-weight: 600; color: #23282f; }
.cat-empty-sub { margin-top: 10rpx; font-size: 25rpx; color: #6b7280; }

.tpl-card {
  background: #fff;
  border: 1px solid #e4e8ee;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}
.thumb-wrap {
  position: relative;
  height: 430rpx;
  background: #f2f4f7;
  overflow: hidden;
  border-bottom: 1px solid #e4e8ee;
}
/* 缩略图缩放：纸张固定 794px 宽，整体缩到卡片宽度以内。
 * 倍率由 templates.js 的 thumbScale() 按屏宽算出后从 data 传入，
 * 固定 0.42 在 320px 屏上会让纸面横向溢出、右边被裁掉一块。 */
.thumb-scale {
  position: absolute;
  left: 50%;
  top: 16rpx;
  width: 794px;
  transform-origin: top center;
}
/* 触摸设备没有 hover，这里用常驻的右下角提示代替参考站的悬停蒙层 */
.thumb-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  top: 0;
  display: flex;
  align-items: flex-end;
  justify-content: flex-end;
  padding: 16rpx;
  pointer-events: none;
}
.thumb-mask text {
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(22, 51, 79, 0.72);
  color: #fff;
  font-size: 22rpx;
}
.cur-badge {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: #1f4e79;
  color: #fff;
}

.tpl-meta { padding: 18rpx 22rpx 22rpx; }
.tpl-title-row { display: flex; align-items: baseline; gap: 10rpx; }
.tpl-name { font-size: 30rpx; font-weight: 700; }
.tpl-layout { font-size: 22rpx; color: var(--ink-3); }
.tpl-desc { margin-top: 6rpx; font-size: 24rpx; line-height: 1.7; color: #5b6570; }
.tpl-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-top: 12rpx; }
/* 排列交给全局 .btn-row（两列等分），这里只给上边距 */
.tpl-acts { margin-top: 18rpx; }
