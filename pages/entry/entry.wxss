/*
 * 子页用页面原生滚动而不是 scroll-view：textarea 是原生组件，
 * 放在 scroll-view 里在部分机型上有键盘顶起 / 光标错位问题；页面滚动 + adjust-position 最稳。
 */
page { background: var(--bg); }

.body {
  padding: 16rpx 28rpx 0;
  box-sizing: border-box;
}
/* 给固定底栏让位：底栏约 136rpx + 安全区 */
.body-end { height: calc(200rpx + env(safe-area-inset-bottom)); }

.pos { font-size: 23rpx; color: var(--ink-3); padding: 8rpx 4rpx 4rpx; }
.label { font-size: 26rpx; font-weight: 600; color: var(--ink-2); margin: 20rpx 0 14rpx; }
.label-row { display: flex; align-items: center; justify-content: space-between; }
.hint { margin-top: 12rpx; font-size: 23rpx; color: var(--ink-3); }

/* ---------- 排版选择 ---------- */
.layouts { display: flex; gap: 16rpx; }
.layout {
  flex: 1;
  min-width: 0;
  padding: 20rpx 14rpx 16rpx;
  border-radius: 18rpx;
  background: var(--surface);
  border: 2rpx solid var(--line);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.layout.on { border-color: var(--brand); background: var(--brand-soft); }
.layout-label { font-size: 25rpx; font-weight: 600; color: var(--ink-2); }
.layout.on .layout-label { color: var(--brand); }
.demo {
  width: 100%;
  height: 72rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
  display: flex;
  gap: 8rpx;
  background: #fff;
  border-radius: 8rpx;
  border: 1px solid var(--line);
}
.demo-col { flex: 1; display: flex; flex-direction: column; gap: 6rpx; justify-content: center; }
.demo-col.full { flex: 1; }
.demo-col.right { align-items: flex-end; }
.demo-col.mid { align-items: center; }
.bar { height: 8rpx; border-radius: 4rpx; background: var(--line-2); }
.bar.strong { background: var(--brand-ring); }
.b100 { width: 100%; }
.b90 { width: 90%; }
.b80 { width: 80%; }
.b60 { width: 70%; }

/* ---------- 字段 ---------- */
.field-card {
  margin-top: 24rpx;
  padding: 4rpx 28rpx 28rpx;
  border-radius: 20rpx;
  background: var(--surface);
}
.input {
  height: 96rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
  font-size: 29rpx;
  line-height: 1.65;
  border-radius: 14rpx;
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.textarea.tall { min-height: 320rpx; }
.ph { color: var(--ink-4); }
.mode-link { font-size: 24rpx; color: var(--brand-2); min-height: 64rpx; display: flex; align-items: center; }

/* ---------- 时间 ---------- */
.time-row { display: flex; align-items: center; gap: 12rpx; }
.time-pick { flex: 1; min-width: 0; }
.time-box {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 112rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.time-cap { font-size: 21rpx; color: var(--ink-3); }
.time-val { font-size: 30rpx; font-weight: 600; color: var(--ink); }
.time-box.ph .time-val { color: var(--ink-4); font-weight: 400; }
.time-dash { flex: none; color: var(--ink-4); }
.time-foot { display: flex; align-items: center; gap: 16rpx; margin-top: 18rpx; }
.time-preview { flex: 1; min-width: 0; font-size: 23rpx; color: var(--ink-3); }
.clear { font-size: 24rpx; color: var(--ink-3); min-height: 64rpx; display: flex; align-items: center; }
.chip {
  flex: none;
  min-height: 68rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  border-radius: 34rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  background: var(--surface-2);
  border: 1px solid var(--line);
}
.chip.on { color: var(--brand); background: var(--brand-soft); border-color: var(--brand-ring); font-weight: 600; }

/* ---------- 底部 ---------- */
.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  border-top: 1px solid var(--line);
}
.foot-del { flex: 1; }
.foot-done { flex: 2; }
