.body { padding: 24rpx; }

.head {
  padding: 32rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(140deg, var(--brand), var(--brand-deep));
  border-color: transparent;
  color: #fff;
}
.head-title { font-size: 26rpx; opacity: 0.85; }
.stats { display: flex; margin: 16rpx 0 12rpx; }
.stat {
  flex: 1 1 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
}
.stat-num { font-size: 52rpx; font-weight: 800; line-height: 1.2; }
.stat-num.hot { color: #ffd88a; }
.stat-label { font-size: 24rpx; opacity: 0.85; }
.head-line { text-align: center; opacity: 0.7; }

.cells { overflow: hidden; }
.cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 120rpx;
  padding: 0 28rpx;
  border-bottom: 1px solid var(--line);
}
.cell:last-of-type { border-bottom: none; }
.cell-icon { flex: none; width: 48rpx; font-size: 36rpx; text-align: center; }
.cell-main { flex: 1; min-width: 0; padding: 20rpx 0; }
.cell-title { font-size: 29rpx; font-weight: 600; color: var(--ink); }
.cell-sub { font-size: 23rpx; color: var(--ink-3); }
.cell-arrow { flex: none; font-size: 36rpx; color: var(--ink-4); transition: transform 0.15s; }
.cell-arrow.open { transform: rotate(90deg); }

.about {
  padding: 8rpx 28rpx 28rpx 96rpx;
  border-top: 1px solid var(--line);
}
.about-name { margin-top: 16rpx; font-size: 27rpx; font-weight: 700; }
.about-line { margin-top: 8rpx; font-size: 25rpx; line-height: 1.7; color: var(--ink-2); }
