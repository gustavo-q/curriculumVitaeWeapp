page {
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
  background: #eef1f5;
}

.top {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 4rpx;
}
.indicator { display: flex; align-items: baseline; gap: 14rpx; min-width: 0; }
.ind-no { font-size: 26rpx; color: var(--ink-3); font-variant-numeric: tabular-nums; }
.ind-name { font-size: 36rpx; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ind-badge {
  padding: 2rpx 14rpx;
  border-radius: 20rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 22rpx;
  flex: none;
}
.grid-toggle {
  flex: none;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 32rpx;
  background: #fff;
  border: 1px solid #dfe4ea;
  font-size: 26rpx;
  color: var(--ink-2);
  display: flex;
  align-items: center;
}
.sub { flex: none; padding: 4rpx 28rpx 16rpx; font-size: 23rpx; color: var(--ink-3); }

/* 滑动 */
.swiper { flex: none; width: 100%; }
.slide { display: flex; justify-content: center; align-items: flex-start; padding-top: 8px; box-sizing: border-box; }
.paper-frame {
  position: relative;
  overflow: hidden;
  background: #fff;
  border-radius: 6rpx;
  box-shadow: 0 4rpx 20rpx rgba(20, 40, 70, 0.12);
  transform: scale(0.94);
  transition: transform 0.2s;
}
.paper-frame.is-cur { transform: scale(1); }
.paper-scale { position: absolute; left: 0; top: 0; width: 794px; transform-origin: top left; }

.ph { position: absolute; left: 0; right: 0; top: 0; bottom: 0; padding: 10%; background: #fff; }
.ph-bar { height: 16rpx; width: 40%; border-radius: 8rpx; margin-bottom: 30rpx; }
.ph-line { height: 12rpx; border-radius: 6rpx; background: #e6eaef; margin-bottom: 20rpx; }
.ph-line.short { width: 60%; }
.ph-name { display: block; margin-top: 30rpx; font-size: 26rpx; color: var(--ink-3); }

.cur-badge {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: var(--brand);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
}
.pages-badge {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  background: rgba(22, 40, 60, 0.7);
  color: #fff;
  font-size: 20rpx;
}

/* 网格 */
.grid-scroll { flex: 1; min-height: 0; }
.grid { display: flex; flex-wrap: wrap; justify-content: space-between; padding: 8rpx 28rpx 24rpx; }
.g-cell { width: calc(50% - 10rpx); margin-bottom: 20rpx; }
.g-frame {
  position: relative;
  overflow: hidden;
  background: #fff;
  border-radius: 8rpx;
  border: 2rpx solid #e4e8ee;
}
.g-cell.on .g-frame { border-color: var(--brand); box-shadow: 0 0 0 3rpx var(--brand-ring); }
.g-meta { display: flex; align-items: center; gap: 10rpx; margin-top: 8rpx; }
.g-name { font-size: 25rpx; font-weight: 600; color: var(--ink); }
.g-badge { font-size: 20rpx; color: var(--ink-3); }

.desc { flex: 1; min-height: 0; padding: 12rpx 40rpx 0; font-size: 25rpx; line-height: 1.6; color: var(--ink-2); text-align: center; overflow: hidden; }

.foot {
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1px solid #e4e8ee;
}
.foot-sec { flex: 1; }
.foot-main { flex: 2; }
